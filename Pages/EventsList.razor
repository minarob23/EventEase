@page "/events"
@page "/"

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0">Upcoming Events</h3>
        <small class="text-muted">Showing @FilteredEvents.Count() events</small>
    </div>
    <div class="w-25">
        <input type="text" 
               class="form-control" 
               placeholder="Search events..." 
               @bind="searchQuery" 
               @bind:event="oninput" />
    </div>
</div>

<div class="row" style="max-height: 75vh; overflow-y: auto;">
    <Virtualize Items="@FilteredEvents.ToList()" Context="evt" OverscanCount="4">
        <ItemContent>
            <div class="col-md-4 mb-3" @key="evt.Id">
                <EventCard EventModel="evt" />
            </div>
        </ItemContent>
        <Placeholder>
            <div class="col-md-4 mb-3">
                <div class="card p-3 placeholder-glow">
                    <span class="placeholder col-8 mb-2"></span>
                    <span class="placeholder col-4 mb-2"></span>
                    <span class="placeholder col-6"></span>
                </div>
            </div>
        </Placeholder>
    </Virtualize>
</div>

@code {
    private string searchQuery = string.Empty;
    private List<EventItem> allEvents = new();

    private IEnumerable<EventItem> FilteredEvents =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? allEvents
            : allEvents.Where(e => e.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                  e.Location.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        allEvents = Enumerable.Range(1, 150).Select(i => new EventItem
        {
            Id = i,
            Name = i switch
            {
                1 => "Tech Innovation Summit",
                2 => "Corporate Leadership Workshop",
                3 => "Social Gala & Networking",
                _ => $"Event #{i}: Industry Forum"
            },
            Date = DateTime.Today.AddDays(i * 3),
            Location = $"Hall {(char)('A' + (i % 6))} - Cairo Conference Center"
        }).ToList();
    }
}