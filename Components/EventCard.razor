@inject AppStateService AppState
@implements IDisposable

<div class="card shadow-sm h-100 border-0">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title text-primary mb-0">@EventModel.Name</h5>
            <span class="badge bg-secondary">
                <i class="bi bi-people-fill me-1"></i>@AppState.GetAttendanceCount(EventModel.Id) Attending
            </span>
        </div>
        <h6 class="card-subtitle mb-2 text-muted">@EventModel.Date.ToString("MMM dd, yyyy")</h6>
        <p class="card-text"><strong>Location:</strong> @EventModel.Location</p>

        <div class="mb-3 mt-2">
            <label class="form-label small fw-semibold">Quick Edit Name:</label>
            <input type="text"
                   class="form-control form-control-sm @(string.IsNullOrWhiteSpace(validationError) ? "" : "is-invalid")"
                   value="@EventModel.Name"
                   @oninput="HandleNameChange" />
            @if (!string.IsNullOrWhiteSpace(validationError))
            {
                <div class="invalid-feedback d-block">
                    @validationError
                </div>
            }
        </div>

        <div class="mt-auto pt-2">
            @if (AppState.RegisteredEvents.Contains(EventModel.Id))
            {
                <div class="alert alert-success py-1 px-2 text-center small mb-2">
                    <i class="bi bi-check-circle-fill me-1"></i>Registered
                </div>
            }

            <div class="d-flex gap-2">
                <a href="@($"/events/{EventModel.Id}")" class="btn btn-outline-primary btn-sm flex-fill">Details</a>
                <a href="@($"/register/{EventModel.Id}")" 
                   class="btn btn-sm flex-fill @(AppState.RegisteredEvents.Contains(EventModel.Id) ? "btn-outline-secondary disabled" : "btn-primary")">
                    @(AppState.RegisteredEvents.Contains(EventModel.Id) ? "Enrolled" : "Register")
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EventItem EventModel { get; set; } = new();

    private string validationError = string.Empty;

    protected override void OnInitialized() => AppState.OnChange += StateHasChanged;
    public void Dispose() => AppState.OnChange -= StateHasChanged;

    private void HandleNameChange(ChangeEventArgs e)
    {
        var input = e.Value?.ToString()?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(input))
        {
            validationError = "Event name cannot be empty.";
        }
        else if (input.Length < 3)
        {
            validationError = "Event name must be at least 3 characters.";
        }
        else
        {
            validationError = string.Empty;
            EventModel.Name = input;
        }
    }
}